APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"



#admin info
ADMIN_PHONE=
ADMIN_PASSWORD=


#agora
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=


APP_TIMEZONE=

DASHBOARD_PATH=
STD_ZOOM_PATH=
VITE_API_URL=https://mrstudy.net/api/user/admin
VITE_STORAGE_URL=https://mrstudy.net/storage

#zoom credentials
ZOOM_MEETING_SDK_KEY=
ZOOM_MEETING_SDK_SECRET=

# E2EE (server private key must NOT be committed)
E2EE_SERVER_PRIVATE_KEY_PATH=
E2EE_SERVER_PUBLIC_KEY_PATH=
E2EE_MAX_CLOCK_SKEW_MS=30000
E2EE_NONCE_TTL_SECONDS=120
E2EE_RATE_LIMIT_MAX_ATTEMPTS=20
E2EE_RATE_LIMIT_DECAY_SECONDS=60

# Phase-1 Live (Zoom) protection
LIVE_PROTECTION_ENABLED=true
LIVE_PROTECTION_ENFORCE_ENTITLEMENT=true
LIVE_PROTECTION_SIGNATURE_TTL_SECONDS=90
LIVE_PROTECTION_ENFORCE_TIME_WINDOW=true
LIVE_PROTECTION_ISSUE_WINDOW_BEFORE_MINUTES=15
LIVE_PROTECTION_ISSUE_WINDOW_AFTER_MINUTES=360
LIVE_PROTECTION_ENABLE_RATE_LIMIT=true
LIVE_PROTECTION_RATE_LIMIT_MAX_ATTEMPTS=10
LIVE_PROTECTION_RATE_LIMIT_DECAY_SECONDS=300
LIVE_PROTECTION_REQUIRE_DEVICE_ID=false
LIVE_PROTECTION_ENFORCE_DEVICE_CONSISTENCY=true
LIVE_PROTECTION_DEVICE_CONSISTENCY_TTL_SECONDS=21600
LIVE_PROTECTION_ALLOWED_DEVICE_CLASS=
LIVE_PROTECTION_DEVICE_BINDING_SCOPE=user_lecture

# Student device policy (1 mobile + 1 desktop)
DEVICE_POLICY_ENABLED=false
DEVICE_POLICY_REQUIRE_HEADERS=true
DEVICE_POLICY_MAX_MOBILE_DEVICES=1
DEVICE_POLICY_MAX_DESKTOP_DEVICES=1
