APP_NAME=ABQOR
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://mrstudy.net

LOG_CHANNEL=stack
LOG_LEVEL=info

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# Best practice for production (multi-container): shared cache
CACHE_DRIVER=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=file

REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# Paths used by docker-compose.yml builds
DASHBOARD_PATH=../../ABQOR_Dashboard/ABQOR_Dashboard-main
STD_ZOOM_PATH=../../ABQOR_Zoom/ABQOR_Zoom-main

# Dashboard build-time envs
VITE_API_URL=https://mrstudy.net/api/user/admin
VITE_STORAGE_URL=https://mrstudy.net/storage

# Zoom Meeting SDK
ZOOM_MEETING_SDK_KEY=
ZOOM_MEETING_SDK_SECRET=

# Live protection (ship code first, enable flags after updating client builds)
LIVE_PROTECTION_ENABLED=true
LIVE_PROTECTION_ENFORCE_ENTITLEMENT=true
LIVE_PROTECTION_SIGNATURE_TTL_SECONDS=90
LIVE_PROTECTION_ENFORCE_TIME_WINDOW=true
LIVE_PROTECTION_ISSUE_WINDOW_BEFORE_MINUTES=15
LIVE_PROTECTION_ISSUE_WINDOW_AFTER_MINUTES=360
LIVE_PROTECTION_ENABLE_RATE_LIMIT=true
LIVE_PROTECTION_RATE_LIMIT_MAX_ATTEMPTS=10
LIVE_PROTECTION_RATE_LIMIT_DECAY_SECONDS=300

# Start with false until all client apps are updated to send device headers/ids
LIVE_PROTECTION_REQUIRE_DEVICE_ID=false
LIVE_PROTECTION_ENFORCE_DEVICE_CONSISTENCY=true
LIVE_PROTECTION_DEVICE_BINDING_SCOPE=user

# Device policy: enable only after publishing updated apps
DEVICE_POLICY_ENABLED=false
DEVICE_POLICY_REQUIRE_HEADERS=true
DEVICE_POLICY_MAX_MOBILE_DEVICES=1
DEVICE_POLICY_MAX_DESKTOP_DEVICES=1
